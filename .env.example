PORT=3001
CORS_ORIGIN=
DB_NAME=ted-analysys

# For confirm-email
SERVER_ORIGIN=http://localhost:3000
APP_NAME="AI Tenders"
TED_API_BASE_URL=https://api.ted.europa.eu

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_GENERAL_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_DEEP_ANALYSIS_MODEL=gpt-4.1
OPENAI_CLIENT_FIT_MODEL=gpt-4.1

MAIL_SMPT_SERVER=
MAIL_SMPT_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_GENERAL_ANALYSIS_MODEL=deepseek-v4-flash
DEEPSEEK_DEEP_ANALYSIS_MODEL=deepseek-chat

AIGATE_BASE_URL=https://api.aigate.shop/v1
AIGATE_GENERAL_ANALYSIS_MODEL=openai/gpt-5.5
AIGATE_DEEP_ANALYSIS_MODEL=openai/gpt-5.5

# Optional per-analysis provider overrides. Falls back to LLM_PROVIDER, then deepseek.
LLM_GENERAL_ANALYSIS_PROVIDER=deepseek
LLM_DEEP_ANALYSIS_PROVIDER=openai

NEED_TO_UPDATE_TENDER_ESTIMATED_VALUE_EUR_INITIALY=true
NEED_TOGATHER_TED_BASE_INITIALY=true
NEED_TO_SYNC_CURRENCY_EXCHANGE_RATES_INITIALY=true

USER_DASHBOARD_URL=https://tenderwise.net/dashboard

DB_COPY_ENABLED=true
DB_COPY_CDN_PREFIX=/db-dumps
DB_COPY_MAX_COPIES=10
DB_COPY_MONGO_URI=mongodb://127.0.0.1/ted-analysys

DNS_STORAGE=
DNS_PASSWORD=
DNS_PREFIX=

# Brave Search API key, used to corroborate a Company Story pattern with
# real external sources (official company/buyer sites, .gov/EU domains,
# a small curated list of business press) before writing the post. Leave
# empty to disable web enrichment — Company Story then falls back to
# Tenderwize-data-only generation. See WebEnrichmentService.
BRAVE_API_KEY=

# Marketing tasks agent (Search Console + GA4 -> AI -> tasks).
# Service account key: either a path to the JSON key file or the JSON itself.
# Add the service account email as a user in Search Console and as a Viewer
# on the GA4 property. Leave GSC_SITE_URL and GA4_PROPERTY_ID empty to
# disable the weekly cron.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# "sc-domain:tenderwise.net" for a domain property or "https://tenderwise.net/" for a URL-prefix one
GSC_SITE_URL=
# Numeric GA4 property id (Admin -> Property settings)
GA4_PROPERTY_ID=
MARKETING_TASKS_LANGUAGE=ru
# Comma-separated brand terms; brand queries are excluded from SEO opportunities
MARKETING_BRAND_TERMS=tenderwize,tenderwise,tender wize
